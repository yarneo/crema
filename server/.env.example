# Crema advisor server — copy to `.env` and fill in.
# Only needed for the OPTIONAL "Local Mac server" mode (routes shots through the
# `claude` CLI on your Mac, billing to a Claude Max subscription instead of per-call).

# Headless auth for the `claude` CLI. Generate once with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Which model the server asks `claude` for (default: opus). Any `claude --model` value.
CREMA_MODEL=opus
